rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'danik';
    }

    // ---------- users/{uid} : public-ish profile ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if isMe(uid);

      // ---------- users/{uid}/contacts/{contactUid} : private contact list (+ per-contact alias) ----------
      match /contacts/{contactUid} {
        allow read, write: if isMe(uid);
      }

      // ---------- users/{uid}/savedMessages/{id} : "Избранное", notes-to-self ----------
      match /savedMessages/{messageId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }

      // ---------- users/{uid}/systemChat/{id} : personal "Linkage Notifications" feed ----------
      // Self-written for login notices; admin-written for anything else (kept for flexibility,
      // the app currently only uses the shared broadcasts/ collection for admin announcements).
      match /systemChat/{messageId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) || isAdmin();
        allow update, delete: if false;
      }

      // ---------- users/{uid}/sessions/{id} : login history (informational only) ----------
      match /sessions/{sessionId} {
        allow read, create: if isMe(uid);
        allow delete: if isMe(uid);
        allow update: if false;
      }
    }

    // ---------- usernames/{username} -> { uid, authEmail } : lookup / uniqueness index ----------
    // Public read on purpose: logging in has to resolve "username" -> the
    // synthetic Auth email *before* the client is signed in. Neither field
    // is sensitive (authEmail is a random placeholder, not a real address).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- broadcasts/{id} : "Linkage Notifications" announcements, admin-only, everyone reads ----------
    match /broadcasts/{messageId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- groups/{groupId} : groups & channels ----------
    // type == 'group': any member can post. type == 'channel': only members
    // listed in `admins` can post, everyone else in `members` is read-only.
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['group', 'channel']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && (
            get(/databases/$(database)/documents/groups/$(groupId)).data.type == 'group'
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    // ---------- chats/{chatId} : 1:1 conversations ----------
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
