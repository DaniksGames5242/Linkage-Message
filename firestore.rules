rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'danik';
    }

    // Photo/video/file attachments are uploaded straight to Cloudinary from
    // the client; only the resulting HTTPS URL is stored here, so this just
    // sanity-checks the shape (a string, not an oversized blob) rather than
    // enforcing a byte size.
    function attachmentsOk() {
      return (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 500))
        && (!('fileUrl' in request.resource.data) || (request.resource.data.fileUrl is string && request.resource.data.fileUrl.size() <= 500))
        && (!('voiceUrl' in request.resource.data) || (request.resource.data.voiceUrl is string && request.resource.data.voiceUrl.size() <= 500))
        && (!('videoNoteUrl' in request.resource.data) || (request.resource.data.videoNoteUrl is string && request.resource.data.videoNoteUrl.size() <= 500))
        && (!('enc' in request.resource.data) || (request.resource.data.enc.ct is string && request.resource.data.enc.ct.size() <= 60000));
    }

    function isMessageTextEdit() {
      return request.auth.uid == resource.data.senderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt', 'enc']);
    }

    // True when `blocker` has `uid` in their personal block list.
    function hasBlocked(blocker, uid) {
      return uid in get(/databases/$(database)/documents/users/$(blocker)).data.get('blocked', []);
    }

    // Settings → Privacy → "Who can call me": everyone / contacts / nobody.
    function callsAllowed(callee) {
      let setting = get(/databases/$(database)/documents/users/$(callee)).data.get('privacy', {}).get('calls', 'everyone');
      return setting == 'everyone'
        || (setting == 'contacts' && exists(/databases/$(database)/documents/users/$(callee)/contacts/$(request.auth.uid)));
    }

    function isMessageReactionEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // "Delete for me": a participant may only add their own uid to hiddenFor.
    function isHideForMe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        && request.resource.data.hiddenFor.removeAll(resource.data.get('hiddenFor', [])).hasOnly([request.auth.uid]);
    }

    // Poll votes: a member may only change their own entry in `votes`.
    function isPollVote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // ---------- users/{uid} : public-ish profile ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if isMe(uid);

      // ---------- users/{uid}/contacts/{contactUid} : private contact list (+ per-contact alias) ----------
      match /contacts/{contactUid} {
        allow read, write: if isMe(uid);
      }

      // ---------- users/{uid}/savedMessages/{id} : "Избранное", notes-to-self ----------
      match /savedMessages/{messageId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && attachmentsOk();
        allow delete: if isMe(uid);
        allow update: if isMe(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']);
      }

      // ---------- users/{uid}/systemChat/{id} : personal "Linkage Notifications" feed ----------
      // Self-written for login notices; admin-written for anything else (kept for flexibility,
      // the app currently only uses the shared broadcasts/ collection for admin announcements).
      match /systemChat/{messageId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) || isAdmin();
        allow update, delete: if false;
      }

      // ---------- users/{uid}/sessions/{id} : login history (informational only) ----------
      match /sessions/{sessionId} {
        allow read, create: if isMe(uid);
        allow delete: if isMe(uid);
        allow update: if false;
      }
    }

    // ---------- usernames/{username} -> { uid, authEmail } : lookup / uniqueness index ----------
    // Public read on purpose: logging in has to resolve "username" -> the
    // synthetic Auth email *before* the client is signed in. Neither field
    // is sensitive (authEmail is a random placeholder, not a real address).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- broadcasts/{id} : "Linkage Notifications" announcements, admin-only, everyone reads ----------
    match /broadcasts/{messageId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- stories/{id} : 24h ephemeral posts, visible to any signed-in user ----------
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (
          (request.resource.data.image is string
            && request.resource.data.image.size() > 0
            && request.resource.data.image.size() <= 900000)
          || (request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.size() > 0
            && request.resource.data.videoUrl.size() <= 500)
        );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    // ---------- groups/{groupId} : groups & channels ----------
    // type == 'group': any member can post. type == 'channel': only members
    // listed in `admins` can post, everyone else in `members` is read-only.
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['group', 'channel']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && (
            get(/databases/$(database)/documents/groups/$(groupId)).data.type == 'group'
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && attachmentsOk();
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && (isMessageTextEdit() || isMessageReactionEdit() || isPollVote() || isHideForMe());
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // ---------- calls/{callId} : 1:1 WebRTC call signalling ----------
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.kind in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && !hasBlocked(request.resource.data.calleeId, request.auth.uid)
        && callsAllowed(request.resource.data.calleeId);
      allow update: if isSignedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read: if isSignedIn()
          && request.auth.uid in [
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
          ];
        allow create: if isSignedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in [
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
          ];
        allow update, delete: if false;
      }
    }

    // ---------- chats/{chatId} : 1:1 conversations ----------
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && !hasBlocked(get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0], request.auth.uid)
          && !hasBlocked(get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1], request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && attachmentsOk();
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && (isMessageTextEdit() || isMessageReactionEdit() || isPollVote() || isHideForMe());
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
